# Spotify API credentials
# Get these from https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=your_client_id_here
SPOTIFY_CLIENT_SECRET=your_client_secret_here
SPOTIFY_REDIRECT_URI=http://localhost:8888/callback

# Spotify user settings
SPOTIFY_PLAYLIST_NAME=Weekly Metal Discoveries
SPOTIFY_PLAYLIST_DESCRIPTION=Auto-generated playlist from highly-rated metal reviews

# Scraping settings
SCORE_THRESHOLD_PERCENT=70
MAX_TRACKS_PER_ALBUM=3
MAX_ALBUMS_PER_WEEK=50

# State file for tracking added albums
STATE_FILE=data/state.json
